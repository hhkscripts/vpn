#!/bin/bash
# Smart Hotspot Manager - Event based, NO polling

set -euo pipefail

LOG_FILE="/var/log/hotspot-manager.log"
VPN_UUID="pi"
POLICY_SCRIPT="/etc/NetworkManager/dispatcher.d/90-hotspot-vpn-policy"
HOTSPOT_MGR="/usr/local/bin/hotspot-manager.py"

# shellcheck source=/dev/null
[ -f /etc/goodwifi/goodwifi.conf ] && . /etc/goodwifi/goodwifi.conf
VPN_BACKEND="${VPN_BACKEND:-auto}"

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

get_active_vpn() {
    for cand in awg0 wg0 tun0; do
        if ip -4 addr show "$cand" 2>/dev/null | grep -q "inet "; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

if [ "${1:-}" != "eth0" ]; then
    exit 0
fi

case "${2:-}" in
    "up")
        (
            log_message "eth0 connected, checking network..."
            sleep 5

            if ping -c 2 -W 3 8.8.8.8 >/dev/null 2>&1; then
                log_message "Internet available"
                CLIENTS="$(iw dev wlan0 station dump 2>/dev/null | awk '/Station/ {count++} END {print count + 0}')"
                if [ "$CLIENTS" -gt 0 ]; then
                    log_message "Clients connected ($CLIENTS), ensuring VPN policy..."
                    if active_if="$(get_active_vpn)"; then
                        log_message "Active VPN found ($active_if), applying policy..."
                        if [ -x "$POLICY_SCRIPT" ]; then
                            "$POLICY_SCRIPT" "$active_if" up >> "$LOG_FILE" 2>&1 || true
                        fi
                    elif [ -x "$HOTSPOT_MGR" ]; then
                        log_message "VPN not active, restarting configured backend ($VPN_BACKEND)..."
                        python3 "$HOTSPOT_MGR" --restart-vpn >> "$LOG_FILE" 2>&1 || true
                    elif [ "$VPN_BACKEND" = "awg0" ] && command -v awg-quick >/dev/null 2>&1; then
                        log_message "Starting awg0..."
                        awg-quick up awg0 >> "$LOG_FILE" 2>&1 || true
                    else
                        log_message "Falling back to OpenVPN connection: $VPN_UUID..."
                        nmcli connection up "$VPN_UUID" >> "$LOG_FILE" 2>&1 || true
                    fi
                fi
            else
                log_message "No internet, renewing DHCP..."
                dhclient -v eth0 >> "$LOG_FILE" 2>&1 || true
            fi
        ) &
        ;;
esac
