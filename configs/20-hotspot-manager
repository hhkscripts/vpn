#!/bin/bash
# Smart Hotspot Manager - Event based, NO polling

set -euo pipefail

LOG_FILE="/var/log/hotspot-manager.log"
VPN_UUID=""
POLICY_SCRIPT="/etc/NetworkManager/dispatcher.d/90-hotspot-vpn-policy"
HOTSPOT_MGR="/usr/local/bin/hotspot-manager.py"

# shellcheck source=/dev/null
[ -f /etc/goodwifi/goodwifi.conf ] && . /etc/goodwifi/goodwifi.conf
VPN_BACKEND="${VPN_BACKEND:-auto}"
LAN_IF="${LAN_IF:-eth0}"
HOTSPOT_IF="${HOTSPOT_IF:-wlan0}"
PING_TARGET="${PING_TARGET:-8.8.8.8}"

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

get_active_vpn() {
    for cand in awg0 wg0 tun0; do
        if ip -4 addr show "$cand" 2>/dev/null | grep -q "inet "; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

if [ "${1:-}" != "$LAN_IF" ]; then
    exit 0
fi

case "${2:-}" in
    "up")
        (
            log_message "$LAN_IF connected, checking network..."
            sleep 5

            if ping -c 2 -W 3 "$PING_TARGET" >/dev/null 2>&1; then
                log_message "Internet available"
                CLIENTS="$(iw dev "$HOTSPOT_IF" station dump 2>/dev/null | awk '/Station/ {count++} END {print count + 0}')"
                log_message "Hotspot clients connected ($CLIENTS), ensuring VPN policy..."
                if active_if="$(get_active_vpn)"; then
                    log_message "Active VPN found ($active_if), applying policy..."
                    if [ -x "$POLICY_SCRIPT" ]; then
                        "$POLICY_SCRIPT" "$active_if" apply >> "$LOG_FILE" 2>&1 || true
                    fi
                    if [ -x /usr/local/bin/github-vpn-routes.sh ]; then
                        /usr/local/bin/github-vpn-routes.sh >> "$LOG_FILE" 2>&1 || true
                    fi
                elif [ -x "$HOTSPOT_MGR" ]; then
                    log_message "VPN not active, restarting configured backend ($VPN_BACKEND)..."
                    python3 "$HOTSPOT_MGR" --restart-vpn >> "$LOG_FILE" 2>&1 || true
                elif [ "$VPN_BACKEND" = "awg0" ] && command -v awg-quick >/dev/null 2>&1; then
                    log_message "Starting awg0..."
                    awg-quick up awg0 >> "$LOG_FILE" 2>&1 || true
                else
                    vpn_conn="${VPN_UUID:-}"
                    if [ -z "$vpn_conn" ] || ! nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$vpn_conn"; then
                        vpn_conn="$(nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="vpn" || $2=="wireguard" {print $1; exit}')"
                    fi
                    if [ -n "$vpn_conn" ]; then
                        log_message "Activating VPN connection: $vpn_conn..."
                        nmcli connection up "$vpn_conn" >> "$LOG_FILE" 2>&1 || true
                    fi
                fi
            else
                log_message "No internet, renewing DHCP..."
                dhclient -v "$LAN_IF" >> "$LOG_FILE" 2>&1 || true
            fi
        ) &
        ;;
esac
