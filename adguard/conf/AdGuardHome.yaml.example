# Optional reference config for GoodWifi-specific DNS routing.
# Run AdGuard Home once, finish the web setup, then merge the `dns.ipset`
# entries below into adguard/conf/AdGuardHome.yaml and restart the container.
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  upstream_dns:
    - 1.1.1.1
    - 8.8.8.8
  ipset:
    - github.com,githubusercontent.com,actions.githubusercontent.com/vpn_domains
    - binance.com,binance.me,binance.info,binance.org,bnbstatic.com,bntrace.com/local_bypass_domains

# The default AdGuard DNS filter blocks Google Analytics and several Google Ads
# endpoints required by the Analytics and AdMob management dashboards.  Keep
# the main filter enabled, but allow the dashboard/tracking endpoints below.
user_rules:
  - '@@||analytics.google.com^'
  - '@@||google-analytics.com^'
  - '@@||ogads-pa.clients6.google.com^'
  - '@@||googleads.g.doubleclick.net^'
  - '@@||pagead2.googlesyndication.com^'
  - '@@||adservice.google.com^'
